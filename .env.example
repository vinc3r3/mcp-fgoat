# Supabase credentials for the MCP eval. Never commit this file.

# Personal access token: lets the agent's MCP server and the seed scripts act on your account.
# Dashboard -> click your avatar -> Account preferences -> Access Tokens -> Generate new token
SUPABASE_ACCESS_TOKEN=

# Project ref: the 20-character id of the eval project.
# Project Settings -> General -> Project ID (also the subdomain in the project URL)
SUPABASE_PROJECT_REF=

# Project URL, in the form https://<project-ref>.supabase.co
# Project Settings -> API (or the "Connect" button at the top of the project)
SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe for client code; the template app uses it.
# Project Settings -> API Keys
SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_; the legacy equivalent is the service_role key).
# Used ONLY by the check scripts to read back real state. Never given to the agent under test.
# Project Settings -> API Keys
SUPABASE_SECRET_KEY=

# Database password you chose when creating the project (optional).
# Only needed if the seed/reset scripts connect to Postgres directly.
# Project Settings -> Database -> Reset database password if you lost it
SUPABASE_DB_PASSWORD=
