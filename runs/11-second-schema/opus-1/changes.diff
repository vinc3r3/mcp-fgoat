diff --git a/supabase/migrations/20261120132132_stats_access.sql b/supabase/migrations/20261120132132_stats_access.sql
new file mode 100644
index 0000000..a65eaba
--- /dev/null
+++ b/supabase/migrations/20261120132132_stats_access.sql
@@ -0,0 +1,26 @@
+-- Make the stats schema readable through the Data API.
+-- The schema must also be listed under "Exposed schemas" in the project's
+-- Data API settings; that is project config, not SQL.
+--
+-- Access rules:
+--   * visitors (anon) get nothing: no schema usage, no table grants
+--   * signed-in members see the whole activity leaderboard
+--   * signed-in members see only their own reading history
+
+alter table stats.member_activity enable row level security;
+alter table stats.reading_history enable row level security;
+
+grant usage on schema stats to authenticated, service_role;
+
+grant select on stats.member_activity to authenticated;
+grant select on stats.reading_history to authenticated;
+
+-- Server-side jobs (e.g. the nightly refresh) using the service role.
+grant all on all tables in schema stats to service_role;
+grant all on all sequences in schema stats to service_role;
+
+create policy "Members see the activity leaderboard" on stats.member_activity
+  for select to authenticated using (true);
+
+create policy "Members see their own reading history" on stats.reading_history
+  for select to authenticated using ((select auth.uid()) = member_id);
