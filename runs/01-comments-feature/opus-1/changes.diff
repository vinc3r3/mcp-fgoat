--- /dev/null
+++ b/app/actions.ts
@@ -0,0 +1,43 @@
+"use server";
+
+import { refresh } from "next/cache";
+import { createClient } from "@/lib/supabase/server";
+
+export type CommentFormState = { error: string | null };
+
+export async function addComment(
+  _prev: CommentFormState,
+  formData: FormData,
+): Promise<CommentFormState> {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getUser();
+  if (!data.user) return { error: "Sign in to comment." };
+
+  const postId = Number(formData.get("post_id"));
+  const body = String(formData.get("body") ?? "").trim();
+  if (!Number.isInteger(postId)) return { error: "Unknown post." };
+  if (!body) return { error: "Comment can't be empty." };
+  if (body.length > 2000) return { error: "Comment is too long (2000 characters max)." };
+
+  // author_id defaults to auth.uid() in the database; RLS enforces it.
+  const { error } = await supabase.from("comments").insert({ post_id: postId, body });
+  if (error) return { error: error.message };
+
+  refresh();
+  return { error: null };
+}
+
+export async function deleteComment(formData: FormData) {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getUser();
+  if (!data.user) throw new Error("Unauthorized");
+
+  const id = Number(formData.get("id"));
+  if (!Number.isInteger(id)) throw new Error("Unknown comment.");
+
+  // RLS only lets authors delete their own rows; the author_id filter makes that explicit.
+  const { error } = await supabase.from("comments").delete().eq("id", id).eq("author_id", data.user.id);
+  if (error) throw new Error(error.message);
+
+  refresh();
+}
diff --git a/app/comment-form.tsx b/app/comment-form.tsx
new file mode 100644
index 0000000..cae4983
--- /dev/null
+++ b/app/comment-form.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { useActionState } from "react";
+import { addComment, type CommentFormState } from "@/app/actions";
+
+export function CommentForm({ postId }: { postId: number }) {
+  const [state, formAction, pending] = useActionState<CommentFormState, FormData>(addComment, {
+    error: null,
+  });
+
+  return (
+    <form action={formAction} style={{ display: "grid", gap: 8, marginTop: 8 }}>
+      <input type="hidden" name="post_id" value={postId} />
+      <textarea name="body" placeholder="Add a comment" rows={2} maxLength={2000} required />
+      <button type="submit" disabled={pending} style={{ justifySelf: "start" }}>
+        {pending ? "Posting…" : "Comment"}
+      </button>
+      {state.error && <p role="alert">{state.error}</p>}
+    </form>
+  );
+}
