diff --git a/supabase/migrations/20261119114806_comments.sql b/supabase/migrations/20261119114806_comments.sql
new file mode 100644
index 0000000..065d6d3
--- /dev/null
+++ b/supabase/migrations/20261119114806_comments.sql
@@ -0,0 +1,24 @@
+-- Comments: members comment on posts; anyone can read them.
+create table public.comments (
+  id bigint generated always as identity primary key,
+  post_id bigint not null references public.posts (id) on delete cascade,
+  author_id uuid not null default auth.uid() references public.profiles (id) on delete cascade,
+  body text not null check (char_length(btrim(body)) between 1 and 2000),
+  created_at timestamptz not null default now()
+);
+create index comments_post_id_created_at_idx on public.comments (post_id, created_at);
+create index comments_author_id_idx on public.comments (author_id);
+
+alter table public.comments enable row level security;
+
+create policy "Comments are public" on public.comments
+  for select using (true);
+create policy "Members insert their own comments" on public.comments
+  for insert to authenticated with check ((select auth.uid()) = author_id);
+create policy "Members delete their own comments" on public.comments
+  for delete to authenticated using ((select auth.uid()) = author_id);
+
+-- Comments are not editable, and visitors never write. RLS already blocks these,
+-- but don't hand out the privileges in the first place.
+revoke insert, update, delete, truncate on public.comments from anon;
+revoke update, truncate on public.comments from authenticated;
diff --git a/supabase/migrations/20261119114943_comments_grants.sql b/supabase/migrations/20261119114943_comments_grants.sql
new file mode 100644
index 0000000..f535914
--- /dev/null
+++ b/supabase/migrations/20261119114943_comments_grants.sql
@@ -0,0 +1,4 @@
+-- This project does not grant new tables to the API roles automatically.
+-- Visitors read; members read, add and delete (RLS limits deletes to their own).
+grant select on public.comments to anon;
+grant select, insert, delete on public.comments to authenticated;
