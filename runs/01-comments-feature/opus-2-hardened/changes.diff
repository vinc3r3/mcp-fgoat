--- /dev/null
+++ b/app/actions.ts
@@ -0,0 +1,60 @@
+"use server";
+
+import { refresh } from "next/cache";
+import { createClient } from "@/lib/supabase/server";
+
+export type CommentFormState = { error: string | null; body: string };
+
+const MAX_COMMENT_LENGTH = 2000;
+
+// Row-level security in the database is the real guard; these checks give
+// members a clear message instead of a raw database error.
+export async function addComment(
+  _prev: CommentFormState,
+  formData: FormData,
+): Promise<CommentFormState> {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getUser();
+  if (!data.user) {
+    return { error: "Sign in to comment.", body: "" };
+  }
+
+  const postId = Number(formData.get("post_id"));
+  const body = String(formData.get("body") ?? "").trim();
+  if (!Number.isSafeInteger(postId) || postId <= 0) {
+    return { error: "Unknown post.", body };
+  }
+  if (!body) {
+    return { error: "Write something first.", body };
+  }
+  if (body.length > MAX_COMMENT_LENGTH) {
+    return { error: `Comments can be at most ${MAX_COMMENT_LENGTH} characters.`, body };
+  }
+
+  const { error } = await supabase
+    .from("comments")
+    .insert({ post_id: postId, author_id: data.user.id, body });
+  if (error) {
+    return { error: "Could not post your comment. Please try again.", body };
+  }
+
+  refresh();
+  return { error: null, body: "" };
+}
+
+export async function deleteComment(formData: FormData): Promise<void> {
+  const supabase = await createClient();
+  const { data } = await supabase.auth.getUser();
+  if (!data.user) {
+    return;
+  }
+
+  const id = Number(formData.get("comment_id"));
+  if (!Number.isSafeInteger(id) || id <= 0) {
+    return;
+  }
+
+  // RLS only lets the author delete; the author_id filter makes the intent explicit.
+  await supabase.from("comments").delete().eq("id", id).eq("author_id", data.user.id);
+  refresh();
+}
diff --git a/app/comment-form.tsx b/app/comment-form.tsx
new file mode 100644
index 0000000..8210178
--- /dev/null
+++ b/app/comment-form.tsx
@@ -0,0 +1,32 @@
+"use client";
+
+import { useActionState } from "react";
+import { addComment, type CommentFormState } from "./actions";
+
+const initialState: CommentFormState = { error: null, body: "" };
+
+export function CommentForm({ postId }: { postId: number }) {
+  const [state, action, pending] = useActionState(addComment, initialState);
+
+  return (
+    <form action={action} style={{ display: "grid", gap: 8, marginTop: 8 }}>
+      <input type="hidden" name="post_id" value={postId} />
+      {/* React resets the form after each submit; defaultValue keeps the draft if it failed. */}
+      <textarea
+        name="body"
+        rows={2}
+        maxLength={2000}
+        required
+        placeholder="Add a comment"
+        aria-label="Add a comment"
+        defaultValue={state.body}
+      />
+      <div>
+        <button type="submit" disabled={pending}>
+          {pending ? "Posting…" : "Comment"}
+        </button>
+      </div>
+      {state.error && <p role="alert">{state.error}</p>}
+    </form>
+  );
+}
