+"use client";
+
+import { useActionState } from "react";
+import { deleteComment, type CommentState } from "./actions";
+
+const initialState: CommentState = { error: null };
+
+export function DeleteCommentButton({ commentId }: { commentId: number }) {
+  const [state, formAction, pending] = useActionState(deleteComment, initialState);
+
+  return (
+    <form action={formAction} style={{ display: "inline" }}>
+      <input type="hidden" name="comment_id" value={commentId} />
+      <button type="submit" disabled={pending}>Delete</button>
+      {state.error && <span role="alert"> {state.error}</span>}
+    </form>
+  );
+}
