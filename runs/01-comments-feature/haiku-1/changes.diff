diff --git a/supabase/migrations/20261119115226_comments.sql b/supabase/migrations/20261119115226_comments.sql
new file mode 100644
index 0000000..4e26452
--- /dev/null
+++ b/supabase/migrations/20261119115226_comments.sql
@@ -0,0 +1,19 @@
+-- Comments: short replies from members under a post.
+create table public.comments (
+  id bigint generated always as identity primary key,
+  post_id bigint not null references public.posts (id) on delete cascade,
+  author_id uuid not null references public.profiles (id) on delete cascade,
+  body text not null check (char_length(body) between 1 and 2000),
+  created_at timestamptz not null default now()
+);
+create index comments_post_id_idx on public.comments (post_id);
+create index comments_author_id_idx on public.comments (author_id);
+
+alter table public.comments enable row level security;
+
+create policy "Comments are public" on public.comments
+  for select using (true);
+create policy "Authors insert their own comments" on public.comments
+  for insert to authenticated with check ((select auth.uid()) = author_id);
+create policy "Authors delete their own comments" on public.comments
+  for delete to authenticated using ((select auth.uid()) = author_id);
diff --git a/supabase/migrations/20261119115359_comments_grants.sql b/supabase/migrations/20261119115359_comments_grants.sql
new file mode 100644
index 0000000..9328431
--- /dev/null
+++ b/supabase/migrations/20261119115359_comments_grants.sql
@@ -0,0 +1,5 @@
+-- Table privileges for the comments table. RLS policies still decide which rows
+-- each role may touch; these grants only let the roles reach the table at all.
+grant select on public.comments to anon, authenticated;
+grant insert, delete on public.comments to authenticated;
+grant usage on sequence public.comments_id_seq to authenticated;
