@@ -0,0 +1,51 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { createClient } from "@/lib/supabase/server";
+
+export type CommentState = { error: string | null };
+
+const MAX_LENGTH = 2000;
+
+// Server Actions are reachable by direct POST, so each one checks the session
+// itself. The database policies on `comments` are the backstop.
+export async function addComment(_prev: CommentState, formData: FormData): Promise<CommentState> {
+  const postId = Number(formData.get("post_id"));
+  const body = String(formData.get("body") ?? "").trim();
+
+  if (!Number.isInteger(postId) || postId <= 0) return { error: "Unknown post." };
+  if (body.length === 0) return { error: "Write something first." };
+  if ([...body].length > MAX_LENGTH) return { error: `Keep comments under ${MAX_LENGTH} characters.` };
+
+  const supabase = await createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) return { error: "Sign in to comment." };
+
+  const { error } = await supabase
+    .from("comments")
+    .insert({ post_id: postId, author_id: user.id, body });
+  if (error) return { error: error.message };
+
+  revalidatePath("/");
+  return { error: null };
+}
+
+export async function deleteComment(_prev: CommentState, formData: FormData): Promise<CommentState> {
+  const commentId = Number(formData.get("comment_id"));
+  if (!Number.isInteger(commentId) || commentId <= 0) return { error: "Unknown comment." };
+
+  const supabase = await createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) return { error: "Sign in to delete comments." };
+
+  // Only the author may delete; RLS enforces this too.
+  const { error } = await supabase
+    .from("comments")
+    .delete()
+    .eq("id", commentId)
+    .eq("author_id", user.id);
+  if (error) return { error: error.message };
+
+  revalidatePath("/");
+  return { error: null };
+}
diff --git a/app/comments/comment-form.tsx b/app/comments/comment-form.tsx
new file mode 100644
index 0000000..1d2460a
--- /dev/null
+++ b/app/comments/comment-form.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { useActionState } from "react";
+import { addComment, type CommentState } from "./actions";
+
+const initialState: CommentState = { error: null };
+
+export function CommentForm({ postId }: { postId: number }) {
+  const [state, formAction, pending] = useActionState(addComment, initialState);
+
+  return (
+    <form action={formAction} style={{ display: "grid", gap: 8, marginTop: 12 }}>
+      <input type="hidden" name="post_id" value={postId} />
+      <textarea name="body" rows={3} maxLength={2000} placeholder="Add a comment" required />
+      <div>
+        <button type="submit" disabled={pending}>Comment</button>
+      </div>
+      {state.error && <p role="alert">{state.error}</p>}
+    </form>
+  );
+}
