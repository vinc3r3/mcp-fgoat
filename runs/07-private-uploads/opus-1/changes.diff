diff --git a/app/track-upload.tsx b/app/track-upload.tsx
new file mode 100644
index 0000000..2132f82
--- /dev/null
+++ b/app/track-upload.tsx
@@ -0,0 +1,55 @@
+"use client";
+
+import { useState } from "react";
+import { createClient } from "@/lib/supabase/client";
+
+const MAX_BYTES = 5 * 1024 * 1024;
+
+export default function TrackUpload({ userId }: { userId: string }) {
+  const [status, setStatus] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  async function upload(formData: FormData) {
+    const file = formData.get("track");
+    if (!(file instanceof File) || file.size === 0) {
+      setStatus("Choose a GPX file first.");
+      return;
+    }
+    if (!file.name.toLowerCase().endsWith(".gpx")) {
+      setStatus("Only .gpx files can be uploaded.");
+      return;
+    }
+    if (file.size > MAX_BYTES) {
+      setStatus("That file is over 5 MB.");
+      return;
+    }
+
+    setBusy(true);
+    setStatus(null);
+    const supabase = createClient();
+    const safeName = file.name.replace(/[^\w.-]+/g, "_");
+    // Browsers rarely know the GPX MIME type, so set it explicitly; the bucket
+    // only accepts application/gpx+xml.
+    const { error } = await supabase.storage
+      .from("tracks")
+      .upload(`${userId}/${safeName}`, file, {
+        contentType: "application/gpx+xml",
+        upsert: true,
+      });
+    setBusy(false);
+    setStatus(error ? `Upload failed: ${error.message}` : `Uploaded ${safeName}.`);
+  }
+
+  return (
+    <form action={upload} style={{ display: "flex", gap: 12, alignItems: "center", margin: "16px 0" }}>
+      <label>
+        GPX track{" "}
+        <input name="track" type="file" accept=".gpx,application/gpx+xml" required />
+      </label>
+      <button type="submit" disabled={busy}>
+        {busy ? "Uploading…" : "Upload"}
+      </button>
+      {status && <span role="status">{status}</span>}
+    </form>
+  );
+}
diff --git a/supabase/migrations/20261119111111_tracks_storage.sql b/supabase/migrations/20261119111111_tracks_storage.sql
new file mode 100644
